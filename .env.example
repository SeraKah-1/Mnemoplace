# ─── Option 1: Vertex AI (Google Cloud Platform) ───
# Set USE_VERTEX_AI=true or define GOOGLE_CLOUD_PROJECT
# USE_VERTEX_AI="true"
# GOOGLE_CLOUD_PROJECT="your-gcp-project-id"
# GOOGLE_CLOUD_LOCATION="us-central1"

# ─── Option 2: Gemini Developer API (API Key) ───
# GEMINI_API_KEY: Required if not using Vertex AI ADC
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# ─── App Configuration ───
APP_URL="http://localhost:3000"
PORT=3000
# NODE_ENV=production
