rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Primitive Definition
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    
    function incoming() {
      return request.resource.data;
    }
    
    function existing() {
      return resource.data;
    }
    
    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Validation Blueprint for Memory
    function isValidMemory(data, userId) {
      let hasRequiredFields = data.keys().hasAll(['userId', 'content', 'category', 'status', 'createdAt', 'updatedAt']);
      
      let isUserIdValid = data.userId == userId;
      let isContentValid = data.content is string && data.content.size() <= 10000;
      let isCategoryValid = data.category is string && data.category.size() <= 100;
      let isStatusValid = data.status in ['generating', 'completed', 'error'];
      
      let isOperationNameValid = !('operationName' in data) || (data.operationName is string && data.operationName.size() <= 200);
      let isFloorIdValid = !('floorId' in data) || (data.floorId is string && data.floorId.size() <= 128);
      let isPinXValid = !('pinX' in data) || (data.pinX is number);
      let isPinYValid = !('pinY' in data) || (data.pinY is number);
      let isPinLabelValid = !('pinLabel' in data) || (data.pinLabel is string && data.pinLabel.size() <= 200);
      
      return hasRequiredFields && isUserIdValid && isContentValid && isCategoryValid && isStatusValid && isOperationNameValid && isFloorIdValid && isPinXValid && isPinYValid && isPinLabelValid;
    }

    match /users/{userId} {
      allow read, write: if false;

      match /floors/{floorId} {
        allow read, write, delete: if isOwner(userId);
      }

      match /memories/{memoryId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId) && isValidId(memoryId);
        allow create: if isOwner(userId) && isValidId(memoryId) && isValidMemory(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(memoryId) && isValidMemory(incoming(), userId) && incoming().userId == existing().userId;
        allow delete: if isOwner(userId) && isValidId(memoryId);
      }
    }
  }
}
